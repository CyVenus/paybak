<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup and device transfer on Android 12 and higher. Keep in step with backup_rules.xml.
    Only the saved profile is copied (ProfileStore: the "profile" preferences and photo folder).
    With no account backend it is all the user has, and it moves to a new phone the way iOS
    backs up UserDefaults and Application Support.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="profile.xml" />
        <include domain="file" path="profile/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="profile.xml" />
        <include domain="file" path="profile/" />
    </device-transfer>
</data-extraction-rules>
